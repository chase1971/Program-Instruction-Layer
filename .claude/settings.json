{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scorecard-hook-tally.js 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scorecard-hook-tally.js 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
