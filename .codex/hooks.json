{
  "description": "Session scorecard auto-tally and bump enforcement (shared with Cursor and Claude Code).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scorecard-hook-tally.js",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scorecard-hook-tally.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scorecard-enforce.js --precompact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scorecard-enforce.js --stop",
            "timeout": 10,
            "statusMessage": "Checking session scorecard"
          }
        ]
      }
    ]
  }
}
