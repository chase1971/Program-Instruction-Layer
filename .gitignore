# Strict allowlist: ignore everything by default, then un-ignore only the
# files we want backed up to the programs-meta repo.
#
# Per-app git repos under this folder (e.g. School Scrips/Macro App/.git,
# electron-toolbar/.git) are unaffected — git treats their .git directories
# as boundary stops and never tracks anything inside them.

# Ignore every top-level entry
/*

# Un-ignore the meta files we care about
!/CLAUDE.md
!/AGENTS.md
!/APP_LOCATIONS.md
!/HOW_TO_INTERACT_WITH_AI.md
!/README.md
!/cursor-patterns/
!/recipes/
!/.cursor/
!/.gitignore
!/.ignore

# Claude Code skills (capture procedure) + hooks. Local-only: launch.json, settings.local.json
# (machine-specific permission paths). settings.json holds only the scorecard hooks, so it
# syncs to the laptop the same way .cursor/hooks.json does.
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/settings.json

# Codex project hooks — scorecard tally + bump enforcement (mirrors .cursor/hooks.json).
!/.codex/
/.codex/*
!/.codex/hooks.json

# Instruction-layer tooling and docs at the Programs root.
# audit doc, the check-docs robot, and the session scorecard log live on one
# machine only — they never reach the laptop and are not backed up.
# Renamed docs/ -> "agent docs/" on 2026-08-01.
!/agent docs/
!/scripts/

# …but not the scorecard's transient scratch files (rewritten constantly).
/agent docs/.session-scorecard-running.json
/agent docs/.scorecard-bump.json
/agent docs/.scorecard-final.json
node_modules

# Local Netlify folder
.netlify
