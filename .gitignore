# Strict allowlist: ignore everything by default, then un-ignore only the
# files we want backed up to the programs-meta repo.
#
# Per-app git repos under this folder (e.g. School Scrips/Macro App/.git,
# electron-toolbar/.git) are unaffected — git treats their .git directories
# as boundary stops and never tracks anything inside them.

# Ignore every top-level entry
/*

# Un-ignore the meta files we care about
!/CLAUDE.md
!/AGENTS.md
!/APP_LOCATIONS.md
!/HOW_TO_INTERACT_WITH_AI.md
!/cursor-patterns/
!/.cursor/
!/.gitignore
!/.ignore

# Instruction-layer tooling and docs at the Programs root. Without these the
# audit doc, the check-docs robot, and the session scorecard log live on one
# machine only — they never reach the laptop and are not backed up.
!/docs/
!/scripts/

# …but not the scorecard's transient running tally (rewritten constantly).
/docs/.session-scorecard-running.json
/docs/.scorecard-bump.json
/docs/.scorecard-final.json
node_modules

# Local Netlify folder
.netlify
